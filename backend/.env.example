DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE"
APP_TIMEZONE=Asia/Kolkata
LEAVE_MAX_ADVANCE_DAYS=14
LEAVE_DOCUMENTS_DIR=uploads/leave-documents
LEAVE_DOCUMENT_MAX_BYTES=10485760

# Public app origin used in password-reset links (Expo web, or the phone's reachable URL).
RESET_APP_URL=http://localhost:8081
# Resend (https://resend.com). Until a domain is verified, leave EMAIL_FROM unset
# so the API uses "LAMS SCG <onboarding@resend.dev>" and can mail only the Resend account address.
RESEND_API_KEY=
# Local only. Resend's onboarding sender can deliver only to the Resend account address.
RESEND_DEV_INBOX=
EMAIL_FROM=
