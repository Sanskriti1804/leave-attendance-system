        {
          "name": "POST /change-password (alters seed password — skip in Runner if needed)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employeeAccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{employeePassword}}\",\n  \"newPassword\": \"EmployeePassword123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/change-password"
          }
        },
        {
          "name": "POST /logout",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('204', () => pm.response.to.have.status(204));"] } }],
          "request": {
            "method": "POST",
