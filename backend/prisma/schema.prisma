generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Department {
  departmentId   Int        @id @default(autoincrement())
  departmentName String     @db.VarChar(50)
  obsolete       Boolean    @default(false)
  employees      Employee[]
}

model Employee {
  employeeId   Int       @id @default(autoincrement())
  firstName    String    @db.VarChar(25)
  lastName     String?   @db.VarChar(25)
  email        String    @unique @db.VarChar(100)
  passwordHash String    @db.VarChar(100)
  departmentId Int
  role         String
  managerId    Int?
  joiningDate  DateTime? @db.Date
  createdAt    DateTime  @default(now())
  status       String
  obsolete     Boolean   @default(false)
  sex          String?   @db.VarChar(10)

  department   Department @relation(fields: [departmentId], references: [departmentId])
  manager      Employee?  @relation("EmployeeManager", fields: [managerId], references: [employeeId])
  subordinates Employee[] @relation("EmployeeManager")

  attendance            Attendance[]
  attendanceCorrections AttendanceCorrection[]
  leaveApplications     LeaveApplication[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  reviewedLeaves        LeaveApplication[]     @relation("LeaveReviewer")
  reportingManagerLeaves LeaveApplication[]    @relation("LeaveReportingManager")
  reviewedCorrections   AttendanceCorrection[] @relation("CorrectionReviewer")
  uploadedDocuments     LeaveDocument[]
  leaveStatusChanges    LeaveStatusHistory[]   @relation("LeaveStatusChangedBy")
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
}

model Attendance {
  attendanceId   Int       @id @default(autoincrement())
  employeeId     Int
  attendanceDate DateTime  @db.Date
  checkIn        DateTime?
  checkOut       DateTime?
  status         String    @db.VarChar(30)
  lateMinutes    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee    Employee               @relation(fields: [employeeId], references: [employeeId])
  corrections AttendanceCorrection[]

  @@unique([employeeId, attendanceDate])
  @@index([employeeId])
  @@index([attendanceDate])
}

model AttendanceCorrection {
  correctionId       Int       @id @default(autoincrement())
  employeeId         Int
  attendanceId       Int
  correctionDate     DateTime  @db.Date
  correctionType     String    @db.VarChar(50)
  correctLoginTime   DateTime?
  correctLogoutTime  DateTime?
  reason             String
  supportingDocument String?
  status             String    @default("PENDING") @db.VarChar(30)
  reviewedBy         Int?
  hrComments         String?
  createdAt          DateTime  @default(now())
  reviewedAt         DateTime?

  employee   Employee   @relation(fields: [employeeId], references: [employeeId])
  attendance Attendance @relation(fields: [attendanceId], references: [attendanceId])
  reviewer   Employee?  @relation("CorrectionReviewer", fields: [reviewedBy], references: [employeeId])
}

model LeaveType {
  leaveTypeId             Int      @id @default(autoincrement())
  name                    String   @db.VarChar(50)
  description             String?
  requiresMedicalDocument Boolean  @default(false)
  allowedSex              String?  @db.VarChar(10)
  obsolete                Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  leaveApplications LeaveApplication[]
  policies          LeavePolicy[]
}

model LeavePolicy {
  policyId                 Int      @id @default(autoincrement())
  leaveTypeId              Int
  medicalDocumentAfterDays Int?
  includeWeekends          Boolean  @default(false)
  includeHolidays          Boolean  @default(false)
  maxDays                  Decimal? @db.Decimal(5, 2)
  obsolete                 Boolean  @default(false)

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [leaveTypeId])
}

model LeaveApplication {
  leaveId                    Int       @id @default(autoincrement())
  employeeId                 Int
  leaveTypeId                Int
  startDate                  DateTime  @db.Date
  endDate                    DateTime  @db.Date
  durationType               String    @db.VarChar(30)
  halfDayType                String?   @db.VarChar(30)
  numberOfDays               Decimal   @db.Decimal(5, 2)
  reason                     String
  status                     String    @default("DRAFT") @db.VarChar(30)
  hrComments                 String?
  reviewedBy                 Int?
  reviewedAt                 DateTime?
  reportingManagerEmployeeId Int?
  managerApprovalStatus      String?   @db.VarChar(30)
  managerReviewedAt          DateTime?
  managerComments            String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  employee           Employee  @relation(fields: [employeeId], references: [employeeId])
  leaveType          LeaveType @relation(fields: [leaveTypeId], references: [leaveTypeId])
  reviewer           Employee? @relation("LeaveReviewer", fields: [reviewedBy], references: [employeeId])
  reportingManager   Employee? @relation("LeaveReportingManager", fields: [reportingManagerEmployeeId], references: [employeeId])
  documents          LeaveDocument[]
  dateSelections     LeaveDateSelection[]
  statusHistory      LeaveStatusHistory[]

  @@index([employeeId])
  @@index([status])
}

model LeaveDateSelection {
  selectionId Int      @id @default(autoincrement())
  leaveId     Int
  leaveDate   DateTime @db.Date
  session     String   @db.VarChar(30)
  unit        Decimal  @db.Decimal(3, 1)

  leave LeaveApplication @relation(fields: [leaveId], references: [leaveId], onDelete: Cascade)

  @@unique([leaveId, leaveDate])
  @@index([leaveDate])
}

model LeaveStatusHistory {
  historyId   Int      @id @default(autoincrement())
  leaveId     Int
  changedById Int?
  oldStatus   String?  @db.VarChar(30)
  newStatus   String   @db.VarChar(30)
  reason      String?
  changedAt   DateTime @default(now())

  leave     LeaveApplication @relation(fields: [leaveId], references: [leaveId], onDelete: Cascade)
  changedBy Employee?        @relation("LeaveStatusChangedBy", fields: [changedById], references: [employeeId])

  @@index([leaveId])
}

model LeaveDocument {
  documentId  Int      @id @default(autoincrement())
  leaveId     Int
  fileName    String   @db.VarChar(50)
  filePath    String
  fileType    String   @db.VarChar(10)
  contentType String   @db.VarChar(100)
  fileSize    Int
  uploadedBy  Int
  uploadedAt  DateTime @default(now())

  leave    LeaveApplication @relation(fields: [leaveId], references: [leaveId], onDelete: Cascade)
  uploader Employee         @relation(fields: [uploadedBy], references: [employeeId])

  @@index([leaveId])
}

model Notification {
  notificationId Int      @id @default(autoincrement())
  userId         Int
  type           String   @db.VarChar(50)
  title          String   @db.VarChar(50)
  message        String   @db.VarChar(100)
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  user Employee @relation(fields: [userId], references: [employeeId], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  auditId    Int      @id @default(autoincrement())
  userId     Int
  action     String   @db.VarChar(50)
  entityType String   @db.VarChar(100)
  entityId   Int?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  user Employee @relation(fields: [userId], references: [employeeId])

  @@index([entityType, entityId])
}

model Holiday {
  holidayId   Int      @id @default(autoincrement())
  holidayName String   @db.VarChar(100)
  holidayDate DateTime @unique @db.Date
}

model ConfigurationSetting {
  settingId       Int    @id @default(autoincrement())
  settingCategory String @db.VarChar(50)
  settingKey      String @db.VarChar(100)
  settingValue    String @db.VarChar(100)
  settingType     String @db.VarChar(20)

  @@unique([settingCategory, settingKey])
}

model RefreshToken {
  refreshTokenId Int      @id @default(autoincrement())
  employeeId     Int
  tokenHash      String   @db.VarChar(255)
  family         String   @db.VarChar(100)
  isRevoked      Boolean  @default(false)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@index([tokenHash])
  @@index([employeeId])
  @@index([family])
}

model PasswordResetToken {
  resetTokenId Int      @id @default(autoincrement())
  employeeId   Int
  tokenHash    String   @db.VarChar(255)
  isUsed       Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@index([tokenHash])
  @@index([employeeId])
}
